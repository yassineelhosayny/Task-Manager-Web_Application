<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href = "custom.css">
    <title>Task Manager-Registrazione</title>
</head>
<body id ="signInBody">
  <nav id ="signInNav">
    <div id="titletype"><h3>Registrazione</h3></div>
    <%if(errors){%> 
        
        <%}%>
    <form id="signIn" method="POST" action="/registrazione">
         <div>
            <label for="nome">Nome:</label>
            <input name ="nome" type="text" placeholder ="inserici il tuo nome" required>
            <% if (errors && errors.nome) { %>
            <small class="error"><%= errors.nome %></small>
            <% } %>
        </div>
        <div>
            <label for="email">Email:</label>
            <input name ="email" type="email" placeholder ="inserici il tuo email" required>
            <% if (errors && errors.email) { %>
            <small class="error"><%= errors.email %></small>
            <% } %>
        </div>
        <div>
            <label for="password">Password:</label>
            <input name ="password" type="password" minlength= "4" placeholder ="inserici il tuo password"required>
            <% if (errors && errors.password) { %>
            <small class="error"><%= errors.password %></small>
            <% } %>
        </div>
        <div id="ricordami">
            <label for="ricordamiInput">Ricordami</label>
            <input id ="ricordamiInput" name ="ricordami" type="checkbox">
        </div>
        <p> Hai un account? <a href ="/login">Accedi!</a> oppure Torna a <a href="/home">Home!</a></p>
        <div>
            <button id="signInSubmitBtn">Registra</button>
        </div>
        
    </form>
</nav>
</body>
</html>